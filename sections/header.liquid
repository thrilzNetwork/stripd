<header class="header">
  <div class="header-inner">
    <a href="/" class="header-logo">STRIPD</a>
    <nav class="header-nav">
      <a href="/blogs/news">Blog</a>
      <a href="/pages/about">Our Story</a>
      <a href="/cart" class="header-cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </nav>
  </div>
</header>

<style>
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 16px 24px;
  background: rgba(0,0,0,0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-subtle);
}
.header-inner {
  max-width: 448px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-logo {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}
.header-nav {
  display: flex;
  align-items: center;
  gap: 16px;
}
.header-nav a {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-dim);
  transition: color 0.2s;
}
.header-nav a:hover {
  color: var(--text);
}
.header-cart {
  position: relative;
  color: var(--text);
}
.cart-count {
  position: absolute;
  top: -6px;
  right: -6px;
  display: flex;
  width: 16px;
  height: 16px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: white;
  font-size: 9px;
  font-weight: 700;
  color: black;
}
</style>
{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
