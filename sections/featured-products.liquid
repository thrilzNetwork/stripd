{% comment %} Featured Products Section {% endcomment %}
{% assign product_limit = section.settings.limit | default: 12 %}

{% if section.settings.collection %}
  {% assign collection_obj = section.settings.collection %}
{% else %}
  {% assign collection_obj = collections.all %}
{% endif %}

<section id="products" class="featured-products-section">

  {% if section.settings.show_filters %}
  <div class="filters-bar">
    <div class="filters-inner">
      <button class="filter-pill active" data-filter="all">All</button>
      {% for col in collections %}
        {% unless col.handle == 'all' or col.handle == 'frontpage' %}
          <button class="filter-pill" data-filter="{{ col.handle }}">{{ col.title }}</button>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="products-section">
    <div class="products-grid">
      {% if collection_obj and collection_obj.products.size > 0 %}
        {% for product in collection_obj.products limit: product_limit %}
          <a href="{{ product.url }}" class="product-card" data-category="{{ product.type | handleize }}" style="animation-delay: {{ forloop.index0 | times: 80 }}ms">
            <div class="product-image-wrap">
              <div class="product-glow" style="background: {{ product.metafields.custom.color | default: '#ffffff' }}20;"></div>
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400, height: 400 }}" alt="{{ product.title }}" class="product-image" loading="lazy" width="200" height="200">
              {% else %}
                <div class="product-image-placeholder"></div>
              {% endif %}
              <div class="product-badges">
                {% if product.type %}
                  <span class="badge category">{{ product.type }}</span>
                {% endif %}
                {% if product.tags contains 'best-seller' %}
                  <span class="badge best-seller">BEST SELLER</span>
                {% endif %}
              </div>
            </div>
            <div class="product-info">
              <h3 class="product-name">{{ product.title }}</h3>
              {% if product.metafields.custom.tagline %}
                <p class="product-tagline">{{ product.metafields.custom.tagline }}</p>
              {% elsif product.description %}
                <p class="product-tagline">{{ product.description | strip_html | truncate: 60 }}</p>
              {% endif %}
              <div class="product-pricing">
                <span class="product-price">{{ product.price | money }}</span>
                {% if product.metafields.custom.amount %}
                  <span class="product-amount">{{ product.metafields.custom.amount }}</span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <div class="no-products-message">
          <p>No products found. Please select a collection with products in the section settings.</p>
          <a href="/admin/collections" class="btn btn-outline" style="margin-top: 16px; display: inline-flex;">Manage Collections</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
.featured-products-section {
  background: var(--bg);
}

.filters-bar {
  position: sticky;
  top: 57px;
  z-index: 40;
  background: rgba(0,0,0,0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-subtle);
  padding: 16px;
}

.filters-inner {
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px;
  max-width: 1200px;
}

.filter-pill {
  flex-shrink: 0;
  border-radius: 9999px;
  padding: 8px 20px;
  font-size: 13px;
  font-weight: 500;
  border: 1px solid var(--border-subtle);
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.3s;
}

.filter-pill.active {
  background: white;
  color: black;
  border-color: white;
}

.filter-pill:hover {
  border-color: rgba(255,255,255,0.3);
  color: var(--text);
}

.products-section {
  padding: 56px 16px;
}

.products-grid {
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  max-width: 1200px;
}

.product-card {
  display: flex;
  flex-direction: column;
  border-radius: 16px;
  border: 1px solid var(--border-subtle);
  background: var(--surface);
  overflow: hidden;
  transition: all 0.3s;
  opacity: 0;
  transform: translateY(16px);
  animation: cardIn 0.5s ease-out forwards;
}

.product-card:hover {
  border-color: rgba(255,255,255,0.2);
  background: var(--surface-raised);
  transform: translateY(-4px);
}

@keyframes cardIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.product-image-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 32px 20px;
  aspect-ratio: 1;
}

.product-glow {
  position: absolute;
  inset: -16px;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.2;
}

.product-image {
  position: relative;
  z-index: 10;
  width: 180px;
  height: 180px;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.product-card:hover .product-image {
  transform: scale(1.05);
}

@media (min-width: 640px) {
  .product-image {
    width: 200px;
    height: 200px;
  }
}

.product-image-placeholder {
  width: 180px;
  height: 180px;
  background: var(--surface-raised);
  border-radius: 8px;
}

.product-badges {
  position: absolute;
  top: 16px;
  left: 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.badge {
  padding: 4px 10px;
  border-radius: 9999px;
  font-size: 9px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.badge.category {
  color: rgba(255,255,255,0.5);
  border: 1px solid rgba(255,255,255,0.1);
}

.badge.best-seller {
  background: white;
  color: black;
}

.product-info {
  padding: 0 20px 20px;
}

.product-name {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
  margin-bottom: 4px;
}

.product-tagline {
  font-size: 12px;
  color: var(--text-dim);
  margin-bottom: 16px;
  line-height: 1.4;
}

.product-pricing {
  display: flex;
  align-items: center;
  gap: 8px;
}

.product-price {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.product-amount {
  font-size: 11px;
  color: var(--text-faint);
}

.no-products-message {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 24px;
  color: var(--text-muted);
}

.no-products-message p {
  font-size: 14px;
}

@media (min-width: 640px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-pill');
  const cards = document.querySelectorAll('.product-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      filterBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');

      const filter = this.dataset.filter;
      cards.forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = 'flex';
          card.style.animation = 'none';
          card.offsetHeight;
          card.style.animation = 'cardIn 0.5s ease-out forwards';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
});
</script>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display",
      "info": "Select a collection with products"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show collection filters",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Products"
    }
  ]
}
{% endschema %}
