<!-- index.liquid - Homepage -->
<style>.hero,.hero *{opacity:1!important;visibility:visible!important;transform:none!important}</style>
<section class="hero" style="display:flex!important;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:128px 24px 80px;background:#000;color:#fff;min-height:80vh">
  <span style="margin-bottom: 24px; font-size: 11px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(255,255,255,0.4);">13 Formulas · 0 Pills</span>
  <h1 style="font-size: 60px; font-weight: 800; letter-spacing: -0.03em; line-height: 0.88; margin-bottom: 24px;">STRIPD</h1>
  <p style="font-size: 18px; font-weight: 300; letter-spacing: -0.01em; color: rgba(255,255,255,0.6); max-width: 600px; margin-bottom: 12px;">The future of supplements is a strip on your tongue.</p>
  <p style="font-size: 14px; color: rgba(255,255,255,0.3); margin-bottom: 12px;">No pills. No powders. No water. Just dissolve and go.</p>
  <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; margin: 48px auto 0; width: 100%; max-width: 300px;">
    <a href="#products" style="display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 9999px; padding: 12px 28px; font-size: 14px; font-weight: 600; background: white; color: black; text-decoration: none; width: 100%; text-align: center;">Explore Formulas</a>
    <a href="/pages/about" style="display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 9999px; padding: 12px 28px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255,255,255,0.2); color: #fff; text-decoration: none; width: 100%; text-align: center;">Our Story</a>
  </div>
</section>

<section class="marquee">
  <div class="marquee-track">
    {% for i in (1..8) %}
      <span class="marquee-text">FAST ABSORPTION · ZERO WATER · PRECISION DOSED · </span>
    {% endfor %}
  </div>
</section>

{% section 'featured-products' %}

<section id="about-teaser" class="about-teaser">
  <div class="about-teaser-inner">
    <span class="section-label">The Technology</span>
    <h2 class="section-title">Why oral strips?</h2>
    <div class="benefits-grid">
      <div class="benefit-card">
        <span class="benefit-num">01</span>
        <h3 class="benefit-title">Fast Absorption</h3>
        <p class="benefit-desc">Active ingredients bypass the digestive system and enter directly through the oral mucosa — faster onset, higher bioavailability.</p>
      </div>
      <div class="benefit-card">
        <span class="benefit-num">02</span>
        <h3 class="benefit-title">Zero Water Required</h3>
        <p class="benefit-desc">No pills to swallow, no shaker cups to clean. Place on your tongue, let it dissolve, and you're done in seconds.</p>
      </div>
      <div class="benefit-card">
        <span class="benefit-num">03</span>
        <h3 class="benefit-title">Precise Dosing</h3>
        <p class="benefit-desc">Every strip delivers the exact same amount. No measuring scoops, no guessing doses, no inconsistent results.</p>
      </div>
    </div>
  </div>
</section>

{% section 'trust-signals' %}

{% section 'certification-badges' %}

<style>
/* ─── Hero ─── */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 128px 24px 80px;
  overflow: hidden;
}
.sonar-container {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  overflow: hidden;
}
.sonar-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.04);
  width: calc(var(--i) * 180px);
  height: calc(var(--i) * 180px);
  animation: sonar 4s ease-out infinite;
  animation-delay: var(--delay);
}
.sonar-static-1 { position: absolute; width: 300px; height: 300px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.06); }
.sonar-static-2 { position: absolute; width: 500px; height: 500px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.03); }
@keyframes sonar {
  0% { transform: scale(0.8); opacity: 0.6; }
  100% { transform: scale(2.5); opacity: 0; }
}
.hero-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 1;
  transform: translateY(0);
  transition: all 1s ease;
}
.hero-content.fade-in { opacity: 1; transform: translateY(0); }
.hero-label {
  margin-bottom: 24px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--text-dim);
}
.hero-title {
  font-size: 60px;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 0.88;
  margin-bottom: 24px;
}
@media (min-width: 640px) { .hero-title { font-size: 72px; } }
@media (min-width: 768px) { .hero-title { font-size: 96px; } }
@media (min-width: 1024px) { .hero-title { font-size: 120px; } }
.hero-subtitle {
  font-size: 18px;
  font-weight: 300;
  letter-spacing: -0.01em;
  color: var(--text-muted);
  max-width: 600px;
  margin-bottom: 12px;
  margin-top: 24px;
}
@media (min-width: 640px) { .hero-subtitle { font-size: 20px; } }
@media (min-width: 1024px) { .hero-subtitle { font-size: 24px; max-width: 700px; } }
.hero-tagline { font-size: 14px; color: var(--text-faint); margin-bottom: 12px; }
.hero-ctas {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 48px;
  width: 100%;
  max-width: 300px;
}
@media (min-width: 640px) { .hero-ctas { flex-direction: row; max-width: none; } }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 9999px;
  padding: 12px 28px;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.3s;
  white-space: nowrap;
}
.btn-primary { background: white; color: black; }
.btn-primary:hover { opacity: 0.9; transform: scale(1.02); }
.btn-outline { border: 1px solid var(--border-med); color: var(--text); }
.btn-outline:hover { border-color: rgba(255,255,255,0.4); }

/* ─── Marquee ─── */
.marquee {
  width: 100%;
  background: white;
  overflow: hidden;
  padding: 20px 0;
}
.marquee-track {
  display: flex;
  white-space: nowrap;
  animation: marquee-scroll 20s linear infinite;
}
.marquee-text {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: black;
  margin: 0 8px;
}
@keyframes marquee-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* ─── About Teaser ─── */
.about-teaser { padding: 80px 24px; border-top: 1px solid var(--border-subtle); }
.about-teaser-inner { margin: 0 auto; text-align: center; }
.section-label { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-faint); display: block; margin-bottom: 16px; }
.section-title { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 40px; }
.benefits-grid { display: grid; gap: 16px; text-align: left; }
@media (min-width: 768px) { .benefits-grid { grid-template-columns: repeat(3, 1fr); max-width: 960px; margin: 0 auto; } }
.benefit-card { border-radius: 16px; border: 1px solid var(--border-subtle); background: var(--surface); padding: 24px; }
.benefit-num { font-size: 10px; font-family: monospace; font-weight: 700; color: rgba(255,255,255,0.2); display: block; margin-bottom: 12px; }
.benefit-title { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
.benefit-desc { font-size: 12px; line-height: 1.6; color: var(--text-dim); }

/* ─── Responsive ─── */
@media (min-width: 768px) {
  .about-teaser-inner { max-width: 960px; }
}
</style>
