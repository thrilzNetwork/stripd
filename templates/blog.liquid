{% comment %} Blog/News Template {% endcomment %}
{% paginate blog.articles by 12 %}

<div class="blog-page">
  <div class="blog-header">
    <div class="blog-header-inner">
      <span class="section-label">{{ blog.title }}</span>
      <h1 class="blog-title">The Journal</h1>
      <p class="blog-subtitle">Science-backed wellness insights, tips, and stories.</p>
    </div>
  </div>

  {% if blog.articles.size > 0 %}
    <div class="blog-grid">
      {% for article in blog.articles %}
        <article class="blog-card" style="animation-delay: {{ forloop.index0 | times: 100 }}ms">
          <a href="{{ article.url }}" class="blog-card-link">
            {% if article.image %}
              <div class="blog-card-image">
                <img src="{{ article.image | image_url: width: 600, height: 400, crop: 'center' }}" alt="{{ article.title }}" loading="lazy" width="300" height="200">
              </div>
            {% endif %}
            <div class="blog-card-content">
              <div class="blog-card-meta">
                <span class="blog-card-tag">{{ article.tags.first | default: 'Wellness' }}</span>
                <span class="blog-card-date">{{ article.published_at | date: '%b %d, %Y' }}</span>
              </div>
              <h2 class="blog-card-title">{{ article.title }}</h2>
              <p class="blog-card-excerpt">
                {% if article.excerpt != blank %}
                  {{ article.excerpt | strip_html | truncate: 120 }}
                {% else %}
                  {{ article.content | strip_html | truncate: 120 }}
                {% endif %}
              </p>
              <span class="blog-card-cta">Read more →</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="blog-pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-btn">← Previous</a>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="pagination-btn">{{ part.title }}</a>
          {% else %}
            <span class="pagination-btn active">{{ part.title }}</span>
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-btn">Next →</a>
        {% endif %}
      </div>
    {% endif %}
  {% else %}
    <div class="blog-empty">
      <p>No articles yet. Check back soon!</p>
    </div>
  {% endif %}
</div>

{% section 'certification-badges' %}

<style>
.blog-page {
  min-height: 100dvh;
  background: var(--bg);
  color: var(--text);
  padding-top: 80px;
}

.blog-header {
  padding: 60px 24px 40px;
  text-align: center;
  border-bottom: 1px solid var(--border-subtle);
}

.blog-header-inner {
  max-width: 600px;
  margin: 0 auto;
}

.section-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--text-faint);
  margin-bottom: 16px;
}

.blog-title {
  font-size: 36px;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 16px;
}

@media (min-width: 640px) {
  .blog-title {
    font-size: 48px;
  }
}

.blog-subtitle {
  font-size: 16px;
  color: var(--text-muted);
  max-width: 500px;
  margin: 0 auto;
}

.blog-grid {
  max-width: 1200px;
  margin: 0 auto;
  padding: 48px 24px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}

@media (min-width: 640px) {
  .blog-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.blog-card {
  background: var(--surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.3s ease;
  opacity: 0;
  transform: translateY(20px);
  animation: cardIn 0.5s ease-out forwards;
}

@keyframes cardIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.blog-card:hover {
  border-color: rgba(255,255,255,0.15);
  transform: translateY(-4px);
}

.blog-card-link {
  display: block;
}

.blog-card-image {
  aspect-ratio: 3/2;
  overflow: hidden;
  background: var(--surface-raised);
}

.blog-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.blog-card:hover .blog-card-image img {
  transform: scale(1.05);
}

.blog-card-content {
  padding: 24px;
}

.blog-card-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.blog-card-tag {
  padding: 4px 10px;
  border-radius: 9999px;
  border: 1px solid var(--border-subtle);
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-dim);
}

.blog-card-date {
  font-size: 12px;
  color: var(--text-faint);
}

.blog-card-title {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin-bottom: 12px;
  color: var(--text);
}

.blog-card-excerpt {
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.blog-card-cta {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  transition: opacity 0.2s;
}

.blog-card:hover .blog-card-cta {
  opacity: 0.7;
}

.blog-pagination {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 40px 24px 80px;
}

.pagination-btn {
  padding: 10px 18px;
  border: 1px solid var(--border-subtle);
  border-radius: 9999px;
  font-size: 13px;
  color: var(--text-muted);
  transition: all 0.2s;
}

.pagination-btn:hover {
  border-color: var(--border-med);
  color: var(--text);
}

.pagination-btn.active {
  background: white;
  border-color: white;
  color: black;
}

.blog-empty {
  text-align: center;
  padding: 120px 24px;
  color: var(--text-dim);
}
</style>

{% endpaginate %}
